{
  "id": "kondooit-scrapers-default",
  "name": "Kondooit Default Scrapers",
  "version": "0.1.0",
  "description": "Default scraper bundle — public torrent aggregators and sites",
  "min_kondooit_version": "0.0.1",
  "scrapers": [
    {
      "key": "torrentio",
      "name": "Torrentio",
      "type": "api",
      "category": "aggregator",
      "content_types": ["movie", "series"],
      "tier": 1,
      "default_enabled": true,
      "config_schema": {
        "sort": {
          "type": "select",
          "label": "Sort by",
          "options": ["seeders", "size", "quality"],
          "default": "seeders"
        },
        "quality_filter": {
          "type": "select",
          "label": "Quality filter",
          "options": ["other", "480p", "720p", "1080p", "2160p", "scr", "cam"],
          "default": "other"
        }
      }
    },
    {
      "key": "mediafusion",
      "name": "MediaFusion",
      "type": "api",
      "category": "aggregator",
      "content_types": ["movie", "series"],
      "tier": 1,
      "default_enabled": true,
      "config_schema": {
        "stream_type": {
          "type": "select",
          "label": "Stream type",
          "options": ["torrent", "direct"],
          "default": "torrent"
        }
      }
    }
  ]
}
